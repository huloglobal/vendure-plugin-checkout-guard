{
    "name": "@huloglobal/vendure-plugin-checkout-guard",
    "version": "0.5.1",
    "description": "The safety layer around Vendure checkout: Stripe manual-capture holds that place the order, bank transfer with expiry, decline and orphaned payment tracking with Stripe reconciliation, session-bound order lookup, card-testing and login guards, shared checkout rate limits and funnel tracking.",
