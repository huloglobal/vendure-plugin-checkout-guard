        "url": "git+https://github.com/huloglobal/vendure-plugin-checkout-guard.git"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "ui",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "logo.svg",
        "hulo-global-logo.svg",
        "hulo-global-logo-light.svg",
        "hulo-global-logo-dark.svg"
    ],
    "scripts": {
